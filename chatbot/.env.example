# ── Server ────────────────────────────────────────────────
CHATBOT_PORT=3001

# ── AI Provider ────────────────────────────────────────────
# Which LLM provider backs largeModel/fastModel/audioTranscriptionModel: 'openrouter' or 'vertex'.
AI_PROVIDER=openrouter

# ── OpenRouter (used when AI_PROVIDER=openrouter) ─────────
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Models used via OpenRouter
# Large multimodal model (chat + agent + image understanding)
MODEL_LARGE=xiaomi/mimo-v2.5

# Fast/cheap model (text actions, extraction structuring, summarisation)
MODEL_FAST=openai/gpt-oss-120b

# Dedicated speech-to-text model, called via OpenRouter's /audio/transcriptions endpoint
MODEL_AUDIO=mistralai/voxtral-mini-transcribe

# ── Google Vertex AI (used when AI_PROVIDER=vertex) ───────
# GCP project ID hosting the Vertex AI endpoint.
GOOGLE_VERTEX_PROJECT=my-gcp-project

# GCP region serving the Vertex AI endpoint.
GOOGLE_VERTEX_LOCATION=us-central1

# Path to the service account key JSON file used to authenticate with Vertex AI.
# Generate it from a GCP service account with the "Vertex AI User" role.
# If omitted, falls back to file-based Application Default Credentials (GOOGLE_APPLICATION_CREDENTIALS).
GOOGLE_VERTEX_CREDENTIALS_JSON=./service-account.json

# Models used via Vertex AI (Gemini model ids, no vendor prefix)
# MODEL_LARGE=gemini-2.5-flash
# MODEL_FAST=gemini-flash-lite
# Chirp speech-to-text model id (chirp_2 or chirp_3)
# MODEL_AUDIO=chirp_2

# ── Backend ───────────────────────────────────────────────
# Java (Quarkus) domain backend the tools call into
BACKEND_URL=http://127.0.0.1:8080

# ── Database ──────────────────────────────────────────────
# SQLite storage
CHATBOT_DB_PATH=./chatbot.db

# ── Agent Limits ──────────────────────────────────────────
# Maximum tool-calling steps per agent run before the loop stops
AGENT_MAX_STEPS=25
# Maximum tool-calling steps per in-turn sub-agent delegation before it stops
SUBAGENT_MAX_STEPS=12
# Maximum conversation messages kept before compaction kicks in
AGENT_MAX_CHAT_MESSAGES=150

# ── Logging ───────────────────────────────────────────────

# Verbosity threshold: silent | error | warn | info | debug | trace
LOG_LEVEL=info

# Output format: 'text' (human-readable) or 'json' (structured, one object per line).
# Defaults to 'json' when NODE_ENV=production, otherwise 'text'. This var overrides that default.
LOG_FORMAT=text

# Max characters per logged field value before truncation
LOG_MAX_FIELD_CHARS=800

# Prefix each line with an ISO timestamp (text format only)
LOG_TIMESTAMPS=true

# ── Runtime ───────────────────────────────────────────────

# 'production' switches the default log format to JSON for auditing/aggregation (Loki/Grafana)
NODE_ENV=production
