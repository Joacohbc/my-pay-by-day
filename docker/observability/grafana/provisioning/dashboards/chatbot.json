{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "MPBD — Chatbot (AI)",
  "uid": "mpbd-chatbot",
  "tags": ["mypaybyday", "chatbot", "ai"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "flow",
        "type": "custom",
        "query": "chat,agent,delegate,extraction,formPatch,text,title,compaction,recap,audio,audioEdit",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" }
      },
      { "name": "model", "type": "textbox", "query": ".*", "current": { "text": ".*", "value": ".*" } }
    ]
  },
  "panels": [
    { "id": 1, "title": "KPIs", "type": "row", "collapsed": false, "panels": [], "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "id": 2,
      "title": "Model generations",
      "type": "stat",
      "description": "One LLM call. A tool-calling turn makes several, and OpenRouter bills \u2014 and counts as a request \u2014 every one of them, so this is the number to compare against its activity page.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "purple" } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "auto", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "queryType": "instant", "expr": "sum(count_over_time({service=\"chatbot\"} | event=\"llm_generation\" [$__range]))" } ]
    },
    {
      "id": 7,
      "title": "Total tokens",
      "type": "stat",
      "description": "Summed over the selected range. OpenRouter aggregates by UTC day, so align the range to whole UTC days before comparing.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "purple" } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "auto", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "queryType": "instant", "expr": "sum(sum_over_time({service=\"chatbot\"} | event=\"llm_generation\" | json | unwrap totalTokens [$__range]))" } ]
    },
    {
      "id": 8,
      "title": "Cost (OpenRouter)",
      "type": "stat",
      "description": "What OpenRouter charged, summed per generation \u2014 not an estimate derived from token prices. Includes the upstream inference cost billed on BYOK keys. Only as complete as the panel to its right says it is.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "blue" } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "auto", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "queryType": "instant", "expr": "sum(sum_over_time({service=\"chatbot\"} | event=\"llm_generation\" | json | costUsd != `` | unwrap costUsd [$__range]))" } ]
    },
    {
      "id": 32,
      "title": "Generations missing cost",
      "type": "stat",
      "description": "Calls OpenRouter reported no cost for, so the total to the left excludes them. Above zero means Grafana necessarily undercounts the bill, usually because usage accounting is off on a model. This is what keeps an undercount from being silent.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "green" }, { "value": 1, "color": "orange" } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "auto", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "queryType": "instant", "expr": "sum(count_over_time({service=\"chatbot\"} | event=\"llm_generation\" | json | costUsd = `` [$__range])) or vector(0)" } ]
    },
    {
      "id": 33,
      "title": "Tool calls",
      "type": "stat",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "blue" } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "auto", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "queryType": "instant", "expr": "sum(count_over_time({service=\"chatbot\"} | event=\"tool_call\" [$__range]))" } ]
    },
    {
      "id": 34,
      "title": "Backend API calls",
      "type": "stat",
      "description": "Calls the chatbot made to the backend on the user's behalf. Inbound traffic to the chatbot is a cross-service cut and lives on the System dashboard.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "blue" } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "auto", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "queryType": "instant", "expr": "sum(count_over_time({service=\"chatbot\"} | scope=\"chatbot:backend\" | status != `` [$__range]))" } ]
    },
    {
      "id": 35,
      "title": "Agent tasks run",
      "type": "stat",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "blue" } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "auto", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "queryType": "instant", "expr": "sum(count_over_time({service=\"chatbot\"} | event=~\"agent_ok|agent_failed\" [$__range]))" } ]
    },
    {
      "id": 36,
      "title": "LLM runs (turns)",
      "type": "stat",
      "description": "One per turn, however many generations it took. Divide \"Model generations\" by this to see how many LLM calls an average answer costs.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "blue" } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "auto", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "queryType": "instant", "expr": "sum(count_over_time({service=\"chatbot\"} | event=\"llm_run\" [$__range]))" } ]
    },
    {
      "id": 6,
      "title": "LLM call failure %",
      "type": "stat",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "green" }, { "value": 1, "color": "orange" }, { "value": 5, "color": "red" } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "queryType": "instant", "expr": "100 * (sum(count_over_time({service=\"chatbot\"} | event=\"llm_error\" [$__range])) or vector(0)) / sum(count_over_time({service=\"chatbot\"} | event=~\"llm_run|llm_error\" [$__range]))" } ]
    },
    {
      "id": 4,
      "title": "Tool failure %",
      "type": "stat",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "green" }, { "value": 1, "color": "orange" }, { "value": 5, "color": "red" } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "queryType": "instant", "expr": "100 * (sum(count_over_time({service=\"chatbot\"} | event=~\"tool_error|tool_threw\" [$__range])) or vector(0)) / sum(count_over_time({service=\"chatbot\"} | event=\"tool_call\" [$__range]))" } ]
    },
    {
      "id": 5,
      "title": "Agent task failure %",
      "type": "stat",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "green" }, { "value": 1, "color": "orange" }, { "value": 5, "color": "red" } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "queryType": "instant", "expr": "100 * (sum(count_over_time({service=\"chatbot\"} | event=\"agent_failed\" [$__range])) or vector(0)) / sum(count_over_time({service=\"chatbot\"} | event=~\"agent_ok|agent_failed\" [$__range]))" } ]
    },
    {
      "id": 37,
      "title": "Backend call failure %",
      "type": "stat",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "green" }, { "value": 1, "color": "orange" }, { "value": 5, "color": "red" } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "queryType": "instant", "expr": "100 * (sum(count_over_time({service=\"chatbot\"} | scope=\"chatbot:backend\" | status=~\"[45]..\" [$__range])) or vector(0)) / sum(count_over_time({service=\"chatbot\"} | scope=\"chatbot:backend\" | status != `` [$__range]))" } ]
    },
    { "id": 9, "title": "Tools", "type": "row", "collapsed": false, "panels": [], "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 } },
    {
      "id": 10,
      "title": "Top tools",
      "type": "table",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 9, "w": 14, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "align": "auto" } }, "overrides": [
        { "matcher": { "id": "byName", "options": "Error %" }, "properties": [ { "id": "unit", "value": "percent" }, { "id": "decimals", "value": 1 }, { "id": "custom.cellOptions", "value": { "type": "color-background" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "value": null, "color": "green" }, { "value": 1, "color": "orange" }, { "value": 5, "color": "red" } ] } } ] },
        { "matcher": { "id": "byName", "options": "p95 ms" }, "properties": [ { "id": "unit", "value": "ms" } ] }
      ] },
      "options": { "showHeader": true, "sortBy": [ { "displayName": "Calls", "desc": true } ] },
      "transformations": [
        { "id": "labelsToFields", "options": {} },
        { "id": "joinByField", "options": { "byField": "tool", "mode": "outer" } },
        { "id": "organize", "options": {
          "excludeByName": { "Time 1": true, "Time 2": true, "Time 3": true, "Time 4": true, "Time": true },
          "renameByName": { "tool": "Tool", "Value #A": "Calls", "Value #B": "Errors", "Value #C": "Error %", "Value #D": "p95 ms" }
        } }
      ],
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "queryType": "instant", "expr": "topk(15, sum by (tool) (count_over_time({service=\"chatbot\"} | event=\"tool_call\" [$__range])))" },
        { "refId": "B", "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "queryType": "instant", "expr": "sum by (tool) (count_over_time({service=\"chatbot\"} | event=~\"tool_error|tool_threw\" [$__range]))" },
        { "refId": "C", "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "queryType": "instant", "expr": "100 * (sum by (tool) (count_over_time({service=\"chatbot\"} | event=~\"tool_error|tool_threw\" [$__range])) or vector(0)) / sum by (tool) (count_over_time({service=\"chatbot\"} | event=\"tool_call\" [$__range]))" },
        { "refId": "D", "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "queryType": "instant", "expr": "quantile_over_time(0.95, {service=\"chatbot\"} | event=~\"tool_ok|tool_error\" | unwrap ms [$__range]) by (tool)" }
      ]
    },
    {
      "id": 11,
      "title": "Tool calls over time (by tool)",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 9, "w": 10, "x": 14, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "queryType": "range", "expr": "sum by (tool) (count_over_time({service=\"chatbot\"} | event=\"tool_call\" [$__auto]))", "legendFormat": "{{tool}}" } ]
    },
    {
      "id": 12,
      "title": "Tool latency p50 / p95 (ms)",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "queryType": "range", "expr": "quantile_over_time(0.5, {service=\"chatbot\"} | event=~\"tool_ok|tool_error\" | unwrap ms [$__auto])", "legendFormat": "p50" },
        { "refId": "B", "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "queryType": "range", "expr": "quantile_over_time(0.95, {service=\"chatbot\"} | event=~\"tool_ok|tool_error\" | unwrap ms [$__auto])", "legendFormat": "p95" }
      ]
    },
    {
      "id": 13,
      "title": "Tool calls by kind",
      "type": "barchart",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "orientation": "horizontal", "legend": { "displayMode": "list", "placement": "bottom" }, "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "queryType": "instant", "expr": "sum by (kind) (count_over_time({service=\"chatbot\"} | kind != `` [$__range]))", "legendFormat": "{{kind}}" } ]
    },
    { "id": 14, "title": "Tokens & Cost", "type": "row", "collapsed": false, "panels": [], "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 } },
    {
      "id": 15,
      "title": "Tokens by flow",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "queryType": "range", "expr": "sum by (flow) (sum_over_time({service=\"chatbot\"} | event=\"llm_generation\" | flow=~\"$flow\" | json | unwrap totalTokens [$__auto]))", "legendFormat": "{{flow}}" } ]
    },
    {
      "id": 16,
      "title": "Tokens by model",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "queryType": "range", "expr": "sum by (model) (sum_over_time({service=\"chatbot\"} | event=\"llm_generation\" | flow=~\"$flow\" | model=~\"$model\" | json | unwrap totalTokens [$__auto]))", "legendFormat": "{{model}}" } ]
    },
    {
      "id": 17,
      "title": "Input vs output tokens",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 40 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 15, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "queryType": "range", "expr": "sum(sum_over_time({service=\"chatbot\"} | event=\"llm_generation\" | flow=~\"$flow\" | json | unwrap inputTokens [$__auto]))", "legendFormat": "input" },
        { "refId": "B", "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "queryType": "range", "expr": "sum(sum_over_time({service=\"chatbot\"} | event=\"llm_generation\" | flow=~\"$flow\" | json | unwrap outputTokens [$__auto]))", "legendFormat": "output" }
      ]
    },
    {
      "id": 18,
      "title": "Cost by flow",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 40 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4, "custom": { "drawStyle": "line", "fillOpacity": 15, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "queryType": "range", "expr": "sum by (flow) (sum_over_time({service=\"chatbot\"} | event=\"llm_generation\" | flow=~\"$flow\" | json | costUsd != `` | unwrap costUsd [$__auto]))", "legendFormat": "{{flow}}" } ]
    },
    {
      "id": 19,
      "title": "Turn latency p95 by flow (ms)",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 40 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "queryType": "range", "expr": "quantile_over_time(0.95, {service=\"chatbot\"} | event=\"llm_run\" | flow=~\"$flow\" | json | unwrap durationMs [$__auto]) by (flow)", "legendFormat": "{{flow}}" } ]
    },
    {
      "id": 38,
      "title": "Cost per day (UTC)",
      "type": "timeseries",
      "description": "One bar per UTC day, which is how OpenRouter's activity page buckets spend \u2014 this is the panel to reconcile against it. The step is pinned to 1d so buckets land on UTC midnight whatever the dashboard range is. Days older than Loki's retention are absent, not zero.",
      "datasource": { "type": "loki", "uid": "loki" },
