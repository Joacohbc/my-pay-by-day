      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4, "custom": { "drawStyle": "bars", "fillOpacity": 70, "lineWidth": 0, "barAlignment": 0, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "queryType": "range", "interval": "1d", "expr": "sum by (flow) (sum_over_time({service=\"chatbot\"} | event=\"llm_generation\" | flow=~\"$flow\" | json | costUsd != `` | unwrap costUsd [$__interval]))", "legendFormat": "{{flow}}" } ]
