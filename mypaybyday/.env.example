# ── Encryption ────────────────────────────────────────────
# Required in PROD (startup aborts if missing). Optional in DEV: if unset, it falls back
# to an insecure development default. Must be 32+ bytes for AES-256 encryption.
# DB_FIELD_ENCRYPTION_KEY=your-encryption-key-longer-than-32-chars

# ── Database (optional — defaults shown) ──────────────────
# Note: For local development, use a relative path like `mypaybyday.db`.
# If deploying in Docker, use an absolute path like `/data/mypaybyday.db`.
# PRAGMAs (WAL, timeout) are already configured in application.properties, no need to add them here.
# QUARKUS_DATASOURCE_JDBC_URL=jdbc:sqlite:mypaybyday.db

# ── Files (optional — defaults shown) ─────────────────────
# MYPAYBYDAY_FILES_MAX_SIZE=10485760

# ── Server (optional — defaults shown) ────────────────────
# TZ=UTC
# APP_LOG_LEVEL=INFO
# ISO 4217 code every pre-existing amount is backfilled with on the first startup that runs
# the multi-currency migration, and the default the UI seeds its currency picker from.
# The code labels existing amounts; it is not a conversion, so a ledger backfilled with the wrong
# code stays mislabelled — set this before the first startup if your history is not in USD.
# APP_DEFAULT_CURRENCY=USD

# Currency every exchange rate is quoted against ("how many UYU buy 1 USD"). Pick it once:
# quotes recorded against another base are not reinterpreted if it changes.
# APP_EXCHANGE_RATE_BASE_CURRENCY=USD

# Exchange-rate providers, their priority per currency and their secrets are configured apart, in
# config/backend/exchange-rates.properties and config/backend/exchange-rates.env (see the .example files there).

# ── CORS (optional — defaults shown) ──────────────────────
# Allowed origins in prod (empty = same-origin only, behind nginx).
# Example: https://app.midominio.com
# MYPAYBYDAY_CORS_ORIGINS=

# ── MarkItDown sidecar (optional) ─────────────────────────
# Only needed if the sidecar isn't reachable at the dev default below.
# MARKITDOWN_URL=http://localhost:8590